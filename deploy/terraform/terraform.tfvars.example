# Copy to terraform.tfvars and adjust. All values shown are the defaults.

aws_region      = "us-east-1"
name            = "gochat"
instance_type   = "t4g.nano" # ARM/Graviton; use a t3.* type with architecture = "x86_64"
architecture    = "arm64"
# availability_zone = "us-east-1a"  # empty = first available

gochat_port    = 4001
gochat_version = "latest" # or a tag, e.g. "v0.1.0"
github_repo    = "Satyam-1o/gochat"

# Optional SSH access. Leave empty to rely on SSM Session Manager only.
# ssh_key_name = "my-key"
# ssh_cidr     = "203.0.113.4/32" # your IP, never 0.0.0.0/0
